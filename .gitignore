# Python caches
__pycache__/
*.py[cod]
*$py.class

# Test caches
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Local databases and runtime artifacts
*.db
*.sqlite
*.sqlite3

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local env
.env

# Runtime data (keep structure only)
data/instance/*
!data/instance/.gitkeep
data/backups/*
!data/backups/.gitkeep

# Runtime logs
data/logs/*
!data/logs/.gitkeep
