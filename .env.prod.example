# ================================
# HLM-Demo 生产环境变量示例
# 用法：cp .env.prod.example .env 后按注释修改
# ================================

# 必填：应用密钥（请改为强随机字符串）
SECRET_KEY=replace-with-a-strong-random-string

# 必填：宿主机媒体根目录（映射到容器 /media）
# 例：/mnt/media 或 /volume1/media
MEDIA_ROOT=/path/to/media-root

# 可选：镜像标签
IMAGE_TAG=latest

# 可选：Web 端口（宿主机）
APP_PORT=5000

# 可选：基础登录认证（留空表示不启用）
APP_USERNAME=
APP_PASSWORD=

# 可选：请求超时（秒）
REQUEST_TIMEOUT_SECONDS=10

# 通过 HTTPS 反向代理访问时建议设为 true；纯 HTTP 局域网访问请保持 false
SESSION_COOKIE_SECURE=false

# 仅在可信反向代理后设为 true；直接暴露时保持 false
TRUST_PROXY_HEADERS=false

# 仅在明确接受无认证访问时设为 true；默认首次启动会要求创建管理员
HLM_ALLOW_NO_AUTH=false
# 可选：指定首次初始化令牌；留空则自动生成并写入 instance/setup_token.txt
HLM_SETUP_TOKEN=

# 可选：时区
TZ=Asia/Shanghai

# 非必要（保留给固定双目录映射方案，可不填）
# DOWNLOADS_PATH=/path/to/downloads
# LIBRARY_PATH=/path/to/library

# 应用日志分割（防止日志过大）
APP_LOG_MAX_MB=10
APP_LOG_BACKUP_COUNT=5

# 可选：text 或 json
LOG_FORMAT=text


# 可选：Sentry 错误上报
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# 可选：生产 gunicorn 参数（建议 workers=1，worker 模式见 README）
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
