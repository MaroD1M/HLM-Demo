# ================================
# HLM-Demo 生产环境变量示例
# 用法：cp .env.prod.example .env 后按注释修改
# ================================

# 必填：应用密钥（请改为强随机字符串）
SECRET_KEY=replace-with-a-strong-random-string

# 必填：宿主机媒体根目录（映射到容器 /media）
# 例：/mnt/media 或 /volume1/media
MEDIA_ROOT=/path/to/media-root

# 可选：镜像标签
IMAGE_TAG=latest

# 可选：Web 端口（宿主机）
APP_PORT=5000

# 可选：基础登录认证（留空表示不启用）
APP_USERNAME=
APP_PASSWORD=

# 可选：请求超时（秒）
REQUEST_TIMEOUT_SECONDS=10

# 可选：时区
TZ=Asia/Shanghai

# 非必要（保留给固定双目录映射方案，可不填）
# DOWNLOADS_PATH=/path/to/downloads
# LIBRARY_PATH=/path/to/library

# 应用日志分割（防止日志过大）
APP_LOG_MAX_MB=10
APP_LOG_BACKUP_COUNT=5

