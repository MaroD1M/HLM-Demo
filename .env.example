# ================================
# HLM-Demo 本地/入门环境变量示例
# 用法：cp .env.example .env 后按注释修改
# ================================

# Web 端口（宿主机）
APP_PORT=5000

# 必填：应用密钥（请改为强随机字符串）
SECRET_KEY=replace-with-a-strong-random-string

# 可选：基础登录认证（留空表示不启用）
APP_USERNAME=
APP_PASSWORD=

# 可选：请求超时（秒）
REQUEST_TIMEOUT_SECONDS=10

# 可选：时区
TZ=Asia/Shanghai

# 推荐：统一映射一个媒体根目录到容器 /media
# 然后在任务里写 /media/xxx 子目录即可（更灵活，适合多任务）
MEDIA_ROOT=./data/media

# 非必要（保留给固定双目录映射方案，可不填）
# DOWNLOADS_PATH=/path/to/downloads
# LIBRARY_PATH=/path/to/library

# 应用日志分割（防止日志过大）
APP_LOG_MAX_MB=10
APP_LOG_BACKUP_COUNT=5


# ================================
# 开发模式（页面配置优先，以下为兜底）
# ================================
# true=启用开发模式；false=正常镜像模式
APP_DEV_MODE=false
# 兜底：true=容器每次重启时自动拉取最新代码
APP_DEV_AUTO_PULL=false
# 兜底仓库地址（建议在页面配置）
APP_DEV_GIT_REPO=https://github.com/MaroD1M/HLM-Demo.git
# 拉取分支
APP_DEV_GIT_BRANCH=master
# 可选：requirements 变化时自动 pip install
APP_DEV_AUTO_PIP_SYNC=false
# 依赖同步超时（秒）
APP_DEV_PIP_SYNC_TIMEOUT=120
# 私有仓库可选 Token（有泄露风险，谨慎使用）
APP_DEV_GIT_TOKEN=

# 可选：开发模式代理地址（容器内访问，建议 host.docker.internal 或宿主机IP）
APP_DEV_PROXY_URL=
# 可选：代理白名单
APP_DEV_NO_PROXY=localhost,127.0.0.1,::1
