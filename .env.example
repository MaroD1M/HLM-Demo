# ================================
# HLM-Demo 本地/入门环境变量示例
# 用法：cp .env.example .env 后按注释修改
# ================================

# Web 端口（宿主机）
APP_PORT=5000

# 必填：应用密钥（请改为强随机字符串）
SECRET_KEY=replace-with-a-strong-random-string

# 可选：基础登录认证（留空表示不启用）
APP_USERNAME=
APP_PASSWORD=

# 可选：请求超时（秒）
REQUEST_TIMEOUT_SECONDS=10

# 可选：部署在 HTTPS 反向代理后时设为 true，避免 Cookie 明文传输
SESSION_COOKIE_SECURE=false

# 可选：仅在可信反向代理后设为 true（否则 X-Forwarded-For 可被伪造）
TRUST_PROXY_HEADERS=false

# 仅在明确接受无认证访问时设为 true；默认首次启动会要求创建管理员
HLM_ALLOW_NO_AUTH=false
# 可选：指定首次初始化令牌；留空则自动生成并写入 instance/setup_token.txt
HLM_SETUP_TOKEN=

# 可选：时区
TZ=Asia/Shanghai

# 推荐：统一映射一个媒体根目录到容器 /media
# 然后在任务里写 /media/xxx 子目录即可（更灵活，适合多任务）
MEDIA_ROOT=./data/media

# 非必要（保留给固定双目录映射方案，可不填）
# DOWNLOADS_PATH=/path/to/downloads
# LIBRARY_PATH=/path/to/library

# 应用日志分割（防止日志过大）
APP_LOG_MAX_MB=10
APP_LOG_BACKUP_COUNT=5

# 可选：text 或 json
LOG_FORMAT=text

# 可选：Sentry 错误上报
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# 可选：生产 gunicorn 参数（建议 workers=1，worker 模式见 README）
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
